rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function mail() { return request.auth.token.email.lower(); }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(mail()));
    }
    function isSelf(email) { return signedIn() && mail() == email; }
    function accountActive() {
      return signedIn()
        && (!exists(/databases/$(database)/documents/users/$(mail()))
          || !('accountStatus' in get(/databases/$(database)/documents/users/$(mail())).data)
          || get(/databases/$(database)/documents/users/$(mail())).data.accountStatus == 'active');
    }
    function bump(field) {
      return request.resource.data.get(field, 0) - resource.data.get(field, 0) >= 0
        && request.resource.data.get(field, 0) - resource.data.get(field, 0) <= 1;
    }

    match /admins/{email} {
      allow get: if isSelf(email);
      allow list, write: if false;
    }

    match /users/{email} {
      allow get: if isSelf(email) || isAdmin();
      allow list: if isAdmin();
      allow create: if (isSelf(email) && accountActive()
          && request.resource.data.email == email
          && request.resource.data.plan == 'FREE'
          && request.resource.data.proUntil == ''
          && request.resource.data.logins == 0
          && request.resource.data.photos == 0
          && request.resource.data.downloads == 0
          && request.resource.data.syncs == 0)
        || isAdmin();
      allow update: if (isSelf(email) && accountActive()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'lastSeen', 'logins', 'photos', 'downloads', 'syncs'])
          && bump('logins') && bump('photos') && bump('downloads') && bump('syncs')
          && request.resource.data.name is string && request.resource.data.name.size() <= 100)
        || isAdmin();
      allow delete: if (isSelf(email) && accountActive()) || isAdmin();
    }

    match /events/{id} {
      allow create: if accountActive()
        && request.resource.data.keys().hasOnly(['time', 'email', 'event', 'details'])
        && request.resource.data.email == mail()
        && request.resource.data.event in ['login', 'photo', 'download', 'cloud_sync', 'denied']
        && request.resource.data.details is string && request.resource.data.details.size() <= 300;
      allow get, list: if isAdmin() || (accountActive() && resource.data.email == mail());
      allow delete: if isAdmin() || (accountActive() && resource.data.email == mail());
      allow update: if false;
    }

    match /feedback/{id} {
      allow create: if accountActive()
        && request.resource.data.keys().hasOnly(['time', 'email', 'category', 'message', 'page', 'status'])
        && request.resource.data.email == mail()
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 1500;
      allow get, list: if isAdmin() || (accountActive() && resource.data.email == mail());
      allow update: if (isAdmin()
          && resource.data.get('userRead', false) != true
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'adminReply', 'repliedAt', 'repliedBy', 'replyNotificationId']))
        || (accountActive() && resource.data.email == mail()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userRead', 'userReadAt'])
          && request.resource.data.userRead == true
          && resource.data.get('replyNotificationId', '') != ''
          && get(/databases/$(database)/documents/notifications/$(resource.data.replyNotificationId)).data.email == mail()
          && get(/databases/$(database)/documents/notifications/$(resource.data.replyNotificationId)).data.read == true);
      allow delete: if isAdmin() || (accountActive() && resource.data.email == mail() && !('adminReply' in resource.data));
    }

    match /notifications/{id} {
      allow create: if isAdmin();
      allow get, list: if isAdmin() || (accountActive() && resource.data.email == mail());
      allow update: if accountActive() && resource.data.email == mail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
        && request.resource.data.read == true;
      allow delete: if isAdmin();
    }

    // Firebase Extension: Trigger Email 會監看此集合並寄出通知。
    match /mail/{id} {
      allow create: if isAdmin();
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
